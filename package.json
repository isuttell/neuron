{
  "name": "neuron-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint -c eslint.config.js src/neuron_client/src",
    "preview": "vite preview",
    "test": "jest --coverage=false",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "dev:client": "cd src/neuron_client && npm run dev",
    "build:client": "cd src/neuron_client && npm run build",
    "install:all": "npm install && cd src/neuron_client && npm install"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/neuron_client/src/$1",
      "\\.(jpg|jpeg|png|gif|svg|eot|otf|webp|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-markdown|remark-gfm|rehype-raw|remark-math|rehype-katex|micromark.*|mdast.*|unist.*|hast.*|bail|is-plain-obj|trough|decode-named-character-reference|character-entities|trim-lines|property-information|space-separated-tokens|comma-separated-tokens|vfile.*|unified.*|remark.*|rehype.*|parse5|web-namespaces|zwitch|html-void-elements|ccount|escape-string-regexp|markdown-table|@types/unist|@types/hast|@types/mdast|devlop)/)"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "isolatedModules": true,
          "diagnostics": false
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/neuron_client/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/neuron_client/src/**/*.{ts,tsx}",
      "!src/neuron_client/src/**/*.d.ts",
      "!src/neuron_client/src/vite-env.d.ts",
      "!src/neuron_client/src/main.tsx",
      "!src/neuron_client/src/components/ui/**/*",
      "!src/neuron_client/src/lib/utils.ts",
      "!src/neuron_client/src/**/*.stories.{ts,tsx}",
      "!src/neuron_client/src/setupTests.ts"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@nextui-org/react": "^2.4.8",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@reduxjs/toolkit": "^2.2.8",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.1",
    "framer-motion": "^11.11.8",
    "katex": "^0.16.11",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.27.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-virtuoso": "^4.12.3",
    "rechart": "^0.0.1",
    "recharts": "^2.13.3",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "superagent": "^10.1.1",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/events": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/superagent": "^8.1.9",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^5.4.8",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
