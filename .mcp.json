{
  "mcpServers": {
    "gitea": {
      "type": "stdio",
      "command": "gitea-mcp",
      "args": [
        "-t",
        "stdio",
        "-host",
        "https://gitea.zaks.io"
      ]
    },
    "loki": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "grafana-loki-mcp",
        "-u",
        "https://lapetus.zaks.io/grafana"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github@latest"
      ]
    },
    "postgres-localhost": {
      "command": "postgres-mcp",
      "args": [
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://neuron:postgres@localhost:5432/neuron"
      }
    },
    "neo4j-localhost": {
      "command": "uvx",
      "args": [
        "mcp-neo4j-cypher",
        "--db-url", "bolt://localhost:7687",
        "--user", "neo4j"
      ]
    }
  }
}
