{
    "mcpServers": {
        "gitea": {
            "command": "gitea-mcp",
            "args": [
                "-t",
                "stdio",
                "--host",
                "https://gitea.zaks.io"
            ],
            "env": {
                "GITEA_ACCESS_TOKEN": "${GITEA_ACCESS_TOKEN}"
            }
        }
    }
}