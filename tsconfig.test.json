{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/neuron_client/src/*"]
    },
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "src/neuron_client/src/**/__tests__/**/*.ts",
    "src/neuron_client/src/**/__tests__/**/*.tsx",
    "test/setupTests.ts"
  ]
}
