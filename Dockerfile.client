# Build stage
FROM node:20-alpine AS builder

ARG GIT_COMMIT
ENV GIT_COMMIT=${GIT_COMMIT}

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY src/neuron_client/package*.json ./src/neuron_client/

# Install dependencies
RUN npm ci

# Copy source code
COPY src/neuron_client/ ./src/neuron_client/
COPY postcss.config.js tailwind.config.js tsconfig*.json vite.config.ts components.json ./
COPY scripts/generate-build-info.js ./scripts/

# Build the application
ARG VITE_AUTH0_CLIENT_ID
RUN test -n "$VITE_AUTH0_CLIENT_ID" || (echo "VITE_AUTH0_CLIENT_ID must be set" >&2; exit 1)
RUN npm run build

# Generate build info after build
RUN node scripts/generate-build-info.js

# Production stage
FROM nginx:1.28.0-alpine

# Copy built assets from builder
COPY --from=builder /app/src/neuron_client/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Set environment variable to silence entrypoint logs
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1

# Install curl for health checks
RUN apk add --no-cache curl

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
