# Dashboard Viewer Configuration
# Copy this file to .env and update with your values

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Dashboard Image URL
# This is the image that will be displayed and monitored for changes
IMAGE_URL=https://ha.zaks.io/local/dashboard-art.png

# Home Assistant Configuration (optional)
# Required only if you want to fetch sensor data from Home Assistant
HOMEASSISTANT_URL=https://ha.zaks.io
HOMEASSISTANT_TOKEN=your-long-lived-access-token-here

# Development Mode
# Set to true to enable auto-reload and debug features
DEV_MODE=false

# Path Configuration
# Base path for subpath deployment (e.g., '/dashboard' for serving at /dashboard/*)
# Leave empty for root deployment
VITE_BASE_PATH=
